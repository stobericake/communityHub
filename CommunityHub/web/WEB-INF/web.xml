<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>volunteerServlet</servlet-name>
        <servlet-class>com.hub.controller.volunteerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>volunteerServlet</servlet-name>
        <url-pattern>/volunteer_servlet.do</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>getImage</servlet-name>
        <servlet-class>com.hub.controller.getImage</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>getImage</servlet-name>
        <url-pattern>/getImage.do</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>UpdateEventStatus</servlet-name>
        <servlet-class>com.hub.controller.UpdateEventStatus</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateEventStatus</servlet-name>
        <url-pattern>/updatestatus.do</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>addServiceReport</servlet-name>
        <servlet-class>com.hub.controller.addServiceReport</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>addServiceReport</servlet-name>
        <url-pattern>/addservice.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
