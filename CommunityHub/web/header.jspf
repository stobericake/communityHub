<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.sql.*" %>
<%@ page import="java.util.Date" %>
<%@ page import="com.hub.controller.dbconnection"%>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>CommUNITYHub</title>
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

        <style>
            body {
                font-family: 'Montserrat', sans-serif;
                padding-top: 90px;
            }

            .header {
                height: 80px;
                background-color: #2F6690;
                z-index: 1030;
                box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
            }

            .nav-link {
                font-weight: bold;
                padding: 12px 15px;
                margin: 0;
            } 

            .nav-link.dropdown{
                font-weight: bold;
                padding: 12px 15px;
                margin: 0;
            }

            .nav-link .dropdown-toggle{
                background-color: transparent !important;
            }

            .nav-link.active {
                background-color: #3A7CA5 !important; 
                color: black !important;
            }

            .nav-link:not(.active) {
                background-color: #C3DFE6;
                color: black;
            }

            .nav-link:not(.active):hover {
                background-color: #3A7CA5;
                color: black;
            }

            .nav-drop {
                color: white;
                font-weight: bold;
                padding: 12px 15px;
                margin: 0;
                text-decoration: none; 
            }


            .profile-dropdown {
                position: relative;
            }

            .profile-dropdown .dropdown-menu {
                right: 0;
                left: auto;
            }

            .profile-img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }

            .profile-dropdown .dropdown-toggle::after {
                display: none;
            }

            .btn-dark {
                transition: box-shadow 0.3s ease, transform 0.3s ease;
            }

            .btn-dark:hover {
                transform: translateY(-2px); /* Slight lift */
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); /* More prominent shadow */
            }


            .nav-item.dropdown {
                position: relative;
            }

            .dropdown-menu {
                display: none;
                position: absolute;
                background-color: white;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
                padding: 10px 0;
                z-index: 1;
                min-width: 150px;
                border-radius: 4px;
            }

            .dropdown-menu .dropdown-item {
                display: block;
                padding: 8px 16px;
                color: #333;
                text-decoration: none;
                transition: background-color 0.3s ease;
            }

            .dropdown-menu .dropdown-item:hover {
                background-color: #f5f5f5;
            }

            .nav-item.dropdown.show .dropdown-menu {
                display: block;
            }

            .dropdown-menu .dropdown-item:hover {
                background-color: #f5f5f5;
                color: #333;
            }

            @media print {
                /* Hide the print button during print */
                .print-button {
                    display: none !important;
                }

                .header {
                    display: none !important;
                }

            }

        </style>
    </head>
    <body>
        <!-- Header -->
        <nav class="header navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container-fluid">
                <a href="<%=request.getContextPath()%>/index.html" class="text-decoration-none">
                    <div class="d-flex align-items-center">
                        <img src="<%=request.getContextPath()%>/assets/logo.png" alt="Logo" style="height: 60px; vertical-align: middle;" class="me-2 mb-3">
                        <h1 class="h5 text-white font-weight-bold" style="font-size: 30px; -webkit-text-stroke-width: 1px;">CommUNITYHub</h1>
                    </div>

                </a>



                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <%
                            // Check user role and session
                            String userRole = (session != null && session.getAttribute("userRole") != null)
                                    ? session.getAttribute("userRole").toString()
                                    : "guest";
                        %>

                        <!-- Admin Specific Navigation -->



                        <% if (userRole.equals("admin")) {%>
                        <!-- Admin Specific Navigation -->
                        <li class="nav-item dropdown">
                            <a class="nav-drop dropdown-toggle" href="#" id="DropdownHeader" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Menu
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
<!--                                <li><a class="dropdown-item" href="#" onclick="updateDropdownText('Home')">Home</a></li>-->
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/adminList.do" onclick="updateDropdownText('Event Approval')">Event Approval</a></li>
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/reportList" onclick="updateDropdownText('Generate Report')">Generate Report</a></li>
                            </ul>
                        </li>

                        <% } else if (userRole.equals("volunteer")) {%>
                        <!-- Volunteer Specific Navigation -->
                        <li class="nav-item dropdown">
                            <a class="nav-drop dropdown-toggle" href="#" id="DropdownHeader" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Menu
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="volunteerDropdown">
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/volunteer/eventListingVolunteer.jsp" onclick="updateDropdownText('Home')">Home</a></li>
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/myList.do" onclick="updateDropdownText('My Events')">My Events</a></li>
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/volunteer/donationHistory.jsp" onclick="updateDropdownText('My Donations')" >My Donations</a></li>
                            </ul>
                        </li>
                        <% } else if (userRole.equals("beneficiary")) {%>
                        <!-- Beneficiary Specific Navigation -->
                        <li class="nav-item dropdown">
                            <a class="nav-drop dropdown-toggle" href="#" id="DropdownHeader" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Menu
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="beneficiaryDropdown">
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/listEventMgmt.do" onclick="updateDropdownText('Event Management')">Event Management</a></li>
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/beneficiary/donorList.jsp" onclick="updateDropdownText('Donor List')">Donor List</a></li>
                                <li><a class="dropdown-item" href="<%=request.getContextPath()%>/beneficiary/volunteerList.jsp" onclick="updateDropdownText('Volunteer List')">Volunteer List</a></li>
                            </ul>
                        </li>
                        <% } %> 



                        <%
                            String profileImageUrl = "";
                            if (session != null) {
                                if (session.getAttribute("volunteer") != null) {
                                    profileImageUrl = "getImage.do?type=volunteer&id=" + session.getAttribute("volunteer");
                                } else if (session.getAttribute("admin") != null) {
                                    profileImageUrl = "getImage.do?type=admin&id=" + session.getAttribute("admin");
                                } else if (session.getAttribute("beneficiary") != null) {
                                    profileImageUrl = "getImage.do?type=beneficiary&id=" + session.getAttribute("beneficiary");
                                }
                            }
                        %>
                        <% if (session != null && (session.getAttribute("volunteer") != null || session.getAttribute("admin") != null || session.getAttribute("beneficiary") != null)) {%>
                        <li class="nav-item dropdown profile-dropdown ms-3">
                            <a class="nav-drop dropdown-toggle" href="#" id="profileDropdown" role="button" 
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="<%= profileImageUrl%>" 
                                     alt="Profile" class="profile-img">
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                <li><a class="dropdown-item" href="#">
                                        <i class="bi bi-person me-2"></i>My Profile
                                    </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="<%=request.getContextPath()%>/logout" onclick="clearLocalStorage()">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </a></li>
                            </ul>
                        </li>
                        <% } else {%>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="<%=request.getContextPath()%>/login.jsp"><button class="btn btn-dark shadow-sm" type="button">Login</button></a>
                            <a href="<%=request.getContextPath()%>/register.jsp"><button class="btn btn-dark shadow-lg" type="button">Register</button></a>
                        </div>



                        <% }%>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
                                    function updateDropdownText(selectedItem) {

                                        document.getElementById('DropdownHeader').textContent = selectedItem;

                                        // Store the selected item in localStorage
                                        localStorage.setItem('dropdownSelection', selectedItem);


                                    }

                                    document.addEventListener('DOMContentLoaded', function () {

                                        // Retrieve the selected dropdown item from localStorage
                                        const selectedItem = localStorage.getItem('dropdownSelection');

                                        // If there's a stored selection, update the dropdown text
                                        if (selectedItem) {
                                            const dropdown = document.getElementById('DropdownHeader');
                                            if (dropdown) {
                                                dropdown.textContent = selectedItem;
                                            }
                                        }
                                    });

                                    function clearLocalStorage() {
                                        // Clear the dropdown selection stored in localStorage
                                        localStorage.removeItem('dropdownSelection');
                                    }

        </script>
    </body>
</html>